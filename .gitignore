# Runtime databases and application-local state
# -----------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal
runtime/
data/
app-data/

# Keep checked-in fixtures and migration test databases when explicitly placed
# under testdata or fixtures.
!**/testdata/**/*.db
!**/testdata/**/*.sqlite
!**/testdata/**/*.sqlite3
!**/fixtures/**/*.db
!**/fixtures/**/*.sqlite
!**/fixtures/**/*.sqlite3

