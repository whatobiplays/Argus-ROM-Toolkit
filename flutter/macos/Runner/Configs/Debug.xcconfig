#include "../../Flutter/Flutter-Debug.xcconfig"
#include "Warnings.xcconfig"

// Optional machine-local signing overrides for macOS native qualification.
// Keep Debug.local.xcconfig untracked; it may provide CODE_SIGN_IDENTITY,
// DEVELOPMENT_TEAM, and CODE_SIGN_STYLE without publishing owner-specific
// signing values. The native harness forwards these values to Flutter's
// xcodebuild invocation so they override the project's ad-hoc Debug default.
#include? "Debug.local.xcconfig"

// Keep the process-linked bridge in the executable. Xcode's debug-dylib mode
// otherwise puts these exports in argus.debug.dylib behind a launcher stub.
ENABLE_DEBUG_DYLIB = NO

// FRB resolves C ABI symbols with dlsym against the main process. Force-load
// includes the archive; export_dynamic preserves its global process exports.
OTHER_LDFLAGS = $(inherited) -Wl,-export_dynamic -force_load "$(PROJECT_DIR)/../../rust/target/debug/libargus_bridge.a"
